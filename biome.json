{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["apps/**/*.{ts,tsx,js,jsx,json,css}", "packages/**/*.{ts,tsx,js,jsx,json,css}"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@nexus/db": "Direct import of @nexus/db is forbidden in apps/web. Use @nexus/api RPC client to maintain strict backend separation.",
                  "@nexus/kv": "Direct import of @nexus/kv is forbidden in apps/web. Use @nexus/api RPC client to protect cache integrity."
                }
              }
            }
          }
        }
      }
    }
  ]
}
